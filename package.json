{
  "name": "usul-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Usul AI — an Islamic Q&A assistant grounded strictly in the Quran, Hadith, Ijma, and Qiyas, retrieved in that priority order.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:env": "tsx scripts/check-env.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "gaps": "tsx scripts/gaps.ts",
    "setup:db": "tsx scripts/setup-db.ts",
    "ingest": "tsx scripts/ingest.ts",
    "build:widget": "node scripts/build-widget.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/google": "latest",
    "@ai-sdk/groq": "latest",
    "@ai-sdk/react": "latest",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "latest",
    "cloudinary": "^2.11.0",
    "clsx": "latest",
    "katex": "^0.18.7",
    "mammoth": "latest",
    "mongodb": "^7.6.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unpdf": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "dotenv": "latest",
    "esbuild": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "husky": "latest",
    "lint-staged": "latest",
    "prettier": "latest",
    "prettier-plugin-tailwindcss": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,mjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
