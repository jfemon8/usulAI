{
  "name": "usul-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Usul AI — an Islamic Q&A assistant grounded strictly in the Quran, Hadith, Ijma, and Qiyas, retrieved in that priority order.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-widget.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:env": "tsx scripts/check-env.ts",
    "email:test": "tsx scripts/send-test-email.ts",
    "email:preview": "tsx scripts/preview-emails.ts",
    "admin:seed": "tsx scripts/admin-seed.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "calibrate:similarity": "tsx scripts/calibrate-similarity.ts",
    "gaps": "tsx scripts/gaps.ts",
    "backfill:grades": "tsx scripts/backfill-hadith-grades.ts",
    "import:quranenc": "tsx scripts/import-quranenc.ts",
    "import:ijma": "tsx scripts/import-openiti.ts ijma",
    "import:qiyas": "tsx scripts/import-openiti.ts qiyas",
    "import:sirat": "tsx scripts/import-openiti.ts sirat && tsx scripts/import-public-domain.ts sirat",
    "import:fiqh": "tsx scripts/import-openiti.ts fiqh && tsx scripts/import-public-domain.ts fiqh",
    "translate:sources": "tsx scripts/translate-sources.ts",
    "storage:report": "tsx scripts/storage-report.ts",
    "storage:optimize": "tsx scripts/storage-optimize.ts",
    "maintain": "tsx scripts/maintain.ts",
    "setup:db": "tsx scripts/setup-db.ts",
    "ingest": "tsx scripts/ingest.ts",
    "build:widget": "node scripts/build-widget.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/groq": "^4.0.37",
    "@ai-sdk/openai-compatible": "^3.0.48",
    "@ai-sdk/react": "^4.0.96",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-code": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "ai": "^7.0.93",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "katex": "^0.18.7",
    "mailtrap": "^4.10.0",
    "mammoth": "^1.12.2",
    "mongodb": "^7.6.0",
    "next": "^16.3.4",
    "pdfkit": "^0.20.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-zoom-pan-pinch": "^4.2.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unpdf": "^1.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,mjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
